# Box OAuth 2.0 (User Authentication) — see backend/README.md for setup steps.
# CDX acts as whichever Box account completes the one-time authorization in
# backend/scripts/box_oauth_setup.py; that account's own permissions decide
# what CDX can see. No enterprise account needed to register the app itself.
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
# Both redirect URIs must exactly match Redirect URIs configured on the app in
# Box's Developer Console. The first is for the one-time backend authorization
# (scripts/box_oauth_setup.py); the second is for engineers logging in to the
# dashboard (app/routers/auth.py).
BOX_REDIRECT_URI=http://127.0.0.1:8000/api/box/oauth/callback
BOX_LOGIN_REDIRECT_URI=http://127.0.0.1:8000/api/auth/callback
# Where the backend's own OAuth token (auto-refreshed) persists between runs:
# `file` (BOX_TOKEN_STORAGE_PATH, gitignored) or `database` (the box_tokens
# table — use this on hosts whose disk is wiped on deploy, like Render).
BOX_TOKEN_STORAGE=file
BOX_TOKEN_STORAGE_PATH=.box_tokens

# Folder ID of the Dashboard root folder in Box (the tree CDX owns).
# Routes default to this folder when no folder_id is given.
BOX_DASHBOARD_ROOT_FOLDER_ID=

# SQLite in dev, Postgres DSN in prod (postgres:// and postgresql:// URLs from
# managed hosts both work). Migrations run automatically on startup.
DATABASE_URL=sqlite:///./cdx.db

# Signs the dashboard session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
# Set to true wherever the app is served over HTTPS.
SESSION_COOKIE_SECURE=false
# Where the browser lands after Box login.
FRONTEND_URL=http://127.0.0.1:5173

# XRPL anchoring — not consumed by app code yet (Phase 3), but the wallet
# exists now per docs/TIMELINE.md Day 0. Testnet only until decision #6
# (mainnet wallet custody) is resolved — see docs/DECISIONS.md.
XRPL_NETWORK=testnet
XRPL_TESTNET_WALLET_SEED=
