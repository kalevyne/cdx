# Box OAuth 2.0 (User Authentication) — see backend/README.md for setup steps.
# CDX acts as whichever Box account completes the one-time authorization in
# backend/scripts/box_oauth_setup.py; that account's own permissions decide
# what CDX can see. No enterprise account needed to register the app itself.
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
# Must exactly match a Redirect URI configured on the app in Box's Developer Console.
BOX_REDIRECT_URI=http://127.0.0.1:8000/api/box/oauth/callback
# Where the OAuth token (auto-refreshed) persists between runs. Gitignored.
BOX_TOKEN_STORAGE_PATH=.box_tokens

# Folder ID of the Dashboard root folder in Box (the tree CDX owns).
# Routes default to this folder when no folder_id is given.
BOX_DASHBOARD_ROOT_FOLDER_ID=

# SQLite in dev, Postgres DSN in prod.
DATABASE_URL=sqlite:///./cdx.db

# XRPL anchoring — not consumed by app code yet (Phase 3), but the wallet
# exists now per docs/TIMELINE.md Day 0. Testnet only until decision #6
# (mainnet wallet custody) is resolved — see docs/DECISIONS.md.
XRPL_NETWORK=testnet
XRPL_TESTNET_WALLET_SEED=
